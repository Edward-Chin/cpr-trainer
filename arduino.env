# Edit this file before building for your board. Values must be shell-quoted.
# This is a trusted shell configuration file, not a PlatformIO configuration.

# Classic ATmega32U4 Pro Micro, confirmed 5 V; selects the 16 MHz variant.
# Requires the SparkFun AVR Boards package (SparkFun:avr).
ARDUINO_FQBN="SparkFun:avr:promicro:cpu=16MHzatmega32U4"

# Run "Arduino: List connected boards" and copy the port here.
# Example only: /dev/cu.usbmodem12301
ARDUINO_PORT="/dev/cu.usbmodem21401"

# Folder containing a .ino file with the same name as the folder.
ARDUINO_SKETCH="sketches/BuzzerTest"

# Must match Serial.begin(...) in your sketch.
ARDUINO_BAUD="115200"

# Optional executable override. Empty means search PATH, then Arduino IDE's
# bundled CLI on macOS. Arduino IDE does not need to be running.
ARDUINO_CLI=""
